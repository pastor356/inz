        <mxCell id="w0lNoqg6YXwCCjPjnnBq-21" value="+ send(std::string const&amp;amp; outputBuf): void override&lt;div&gt;+ recv(std::string&amp;amp; inputBuf): Status override&lt;/div&gt;&lt;div&gt;+ getIpAddr(): std::string const&amp;amp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;# getDescriptor(): int&lt;/span&gt;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" parent="w0lNoqg6YXwCCjPjnnBq-18" vertex="1">
          <mxGeometry y="72" width="285" height="68" as="geometry" />
        </mxCell>
        <mxCell id="w0lNoqg6YXwCCjPjnnBq-22" value="&lt;font style=&quot;color: rgb(255, 0, 98);&quot;&gt;(1)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="480" y="-830" width="40" height="30" as="geometry" />
        </mxCell>
        <mxCell id="w0lNoqg6YXwCCjPjnnBq-23" value="&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 98);&quot;&gt;(1)&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt; &lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Przeciążenie z dod. argumentem &lt;/font&gt;&lt;font face=&quot;IBM Plex Mono&quot; style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;size_t &lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt;n&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;font face=&quot;IBM Plex Mono&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;color: rgb(255, 0, 0);&quot;&gt;(2) &lt;/font&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;color: rgb(255, 255, 255);&quot;&gt;Metody accept() i connect() w klasach TcpSocket i TlsSocket są jednakowe, ale w TlsSocket implementuje się nowe metody createCaller/Callee(), dodajemy owijkę z Tls/Dtls&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;color: rgb(255, 0, 18);&quot;&gt;(3)&lt;/font&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;color: light-dark(rgb(255, 255, 255), rgb(244, 240, 240));&quot;&gt;ConnectionWrapper&lt;/font&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;color: rgb(255, 255, 255);&quot;&gt; odpowiada za QoS (IQualityStrategy) i pakiety KeepAlive (LiveMonitor) &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;(ConnectionSupervisor::recv() {&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;liveMon.resetTimer();&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;qosStrategy.recv();&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;liveMon.lastActivity(std::chrono::steady_clock::now()&lt;br&gt;&lt;/div&gt;&lt;div&gt;})&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(255, 0, 18);&quot;&gt;(4) &lt;/span&gt;&lt;span&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Stan połączenia: onHold -- gdy KeepAlive nie przyszedł w okresie &lt;font face=&quot;IBM Plex Mono&quot; style=&quot;&quot;&gt;timeOut1, &lt;/font&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;&quot;&gt;tempDisconnected -- gdy nie przyszedł w okresie&amp;nbsp;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;IBM Plex Mono&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;timeOut2, &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Disconnected, gdy nie odpowiada na po&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;(5)&lt;/font&gt; W przypadku UDP f-cja &lt;font face=&quot;IBM Plex Mono&quot;&gt;accept()&lt;/font&gt; robi kopię UdpSocket::sockFd i przekazuje ją przy tworzeniu do UdpConnection::connectionFd&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="360" y="-2440" width="460" height="380" as="geometry" />
        </mxCell>
        <mxCell id="w0lNoqg6YXwCCjPjnnBq-24" value="&lt;div style=&quot;line-height: 160%;&quot;&gt;«interface»&lt;br&gt;&lt;b&gt;ISocket&lt;/b&gt;&lt;div style=&quot;text-align: left;&quot;&gt;+ accept(): std::unique_ptr&amp;lt;IConnection&amp;gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;+ listen(int backlog): void&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;+ connect(): std::unique_ptr&amp;lt;IConnection&amp;gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;+ bind(std::string const&amp;amp; ipAddr, int port): void&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;+ getDescriptor(): int&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
